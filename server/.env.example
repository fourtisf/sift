# ---- market data ----
# demo = simulated market, no RPC needed. live = Robinhood Chain.
SOURCE=demo
DEMO_SPEED=10
# Use a paid RPC in production (Alchemy, QuickNode, Dwellir, Chainstack). The public one is rate-limited.
RPC_HTTP=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
POLL_MS=1000
BACKFILL_BLOCKS=36000
BLOCKSCOUT_API=https://robinhoodchain.blockscout.com/api/v2

# ---- server ----
PORT=8787
# On Railway set DATABASE_PATH=/data/sift.db (the volume). The folder is created if missing.
DATABASE_PATH=./sift.db
PUBLIC_ORIGIN=http://localhost:8787

# ---- paper trading ----
PAPER_START_ETH=1

# ---- live trading (leave off until the checklist in README is done) ----
LIVE_TRADING_ENABLED=false
# The agent key. It only ever has "agent" rights on user vaults and pays gas. Keep a little ETH on it, nothing else.
AGENT_PRIVATE_KEY=
# SiftVaultFactory address after you deploy contracts/
VAULT_FACTORY=

# ---- AI score (optional; without a key a built-in heuristic score is used) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# ---- optional extras ----
TELEGRAM_BOT_TOKEN=
X_BEARER_TOKEN=
# comma-separated wallets whose holdings count as "smart money"
SMART_WALLETS=
